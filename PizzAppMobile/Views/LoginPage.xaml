<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PizzAppMobile.Views.LoginPage"
             BackgroundColor="White">

    <StackLayout Padding="20" VerticalOptions="Center">
        <Label Text="🔑 Autentificare" 
               FontSize="26" 
               FontAttributes="Bold" 
               HorizontalOptions="Center"
               TextColor="#D32F2F" />

        <Entry x:Name="EmailEntry" 
               Placeholder="Email" 
               Keyboard="Email"
               BackgroundColor="White"
               TextColor="Black"
               PlaceholderColor="Gray"
               Margin="0,10,0,10"/>

        <Entry x:Name="PasswordEntry" 
               Placeholder="Parolă" 
               IsPassword="True"
               BackgroundColor="White"
               TextColor="Black"
               PlaceholderColor="Gray"
               Margin="0,0,0,10"/>

        <Button Text="Autentificare" Clicked="OnLoginClicked"
                BackgroundColor="#D32F2F" TextColor="White"
                CornerRadius="8" FontSize="18"/>
    </StackLayout>
</ContentPage>
