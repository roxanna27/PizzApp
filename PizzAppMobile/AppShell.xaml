<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PizzAppMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PizzAppMobile.Views"
    Shell.FlyoutBehavior="Disabled">

    <!-- Pagina de Login -->
    <ShellContent
        Title="Autentificare"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- Pagina de Produse -->
    <ShellContent
        Title="Meniu"
        ContentTemplate="{DataTemplate views:ProductsPage}"
        Route="ProductsPage" />

    <!-- Pagina Coșului -->
    <ShellContent
        Title="Coș de cumpărături"
        ContentTemplate="{DataTemplate views:CartPage}"
        Route="CartPage" />

</Shell>
